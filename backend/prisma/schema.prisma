// Data model per docs/backend-implementation-plan.md §6.1. Do not hand-edit
// without updating that document — this file is the executable form of it.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7), not here.
datasource db {
  provider = "postgresql"
}

enum MuseumStatus {
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  SYSTEM_ADMIN
  MUSEUM_ADMIN
}

// An account created by an operator but not yet signed into is INVITED;
// SUSPENDED is refused at login without deleting the audit trail behind it.
enum AdminStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// How a visitor proves entry before the guide unlocks (§ gate settings).
enum GateMode {
  TICKET_CODE
  STAFF_ASSISTED
}

enum GuideStyleTone {
  FORMAL
  CONVERSATIONAL
  SCHOLARLY
}

// Subscription and payment enums per dev3-integrations-monetization-plan.md §4.
enum SubscriptionTier {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Museum {
  id                  String       @id @default(uuid())
  name                String
  slug                String       @unique
  status              MuseumStatus @default(ACTIVE)
  cityCountry         String? // free-text locality, shown as the fleet "region"
  ticketValidationUrl String? // null = no ticketing gate for this museum
  systemPrompt        String?      @db.Text // per-museum guide persona (S2)
  defaultVoiceId      String? // per-museum TTS voice (S3)

  // Entry gate configuration. ticketValidationUrl above is the vendor endpoint;
  // these shape how the visitor app presents and tolerates the check.
  gateMode            GateMode @default(TICKET_CODE)
  allowedTicketPrefix String?
  graceWindowMinutes  Int      @default(30)

  // Guide persona and voice presentation. systemPrompt holds the grounding
  // policy; personaName and styleTone are the shorter knobs above it.
  personaName        String?
  guideStyleTone     GuideStyleTone @default(CONVERSATIONAL)
  // Multiplier on the TTS default rate. 1.00 is the provider's own pace.
  speakingRate       Decimal        @default(1.00) @db.Decimal(3, 2)
  pronunciationHints String?        @db.Text

  // Subscription state (dev3 §4). Tier limits live in code
  // (src/modules/billing/tiers.ts); prices live in TierPricing.
  tier                 SubscriptionTier   @default(BASIC)
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  subscriptionRenewsAt DateTime?
  billingEmail         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers AdminUser[]
  rooms      Room[]
  auditLogs  AdminAuditLog[]
  payments   Payment[]

  @@index([status])
  // Serves the reconciler's lapsed-subscription sweep.
  @@index([subscriptionStatus, subscriptionRenewsAt])
}

model AdminUser {
  id           String      @id @default(uuid())
  email        String      @unique
  displayName  String? // shown on the team and admins screens; email is the fallback
  passwordHash String
  role         AdminRole
  status       AdminStatus @default(ACTIVE)
  museumId     String? // null for SYSTEM_ADMIN, required for MUSEUM_ADMIN
  museum       Museum?     @relation(fields: [museumId], references: [id], onDelete: Restrict)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  auditLogs AdminAuditLog[]

  @@index([museumId])
  @@index([status])
}

model Room {
  id               String   @id @default(uuid()) // globally unique — a QR code encodes this
  legacyId         String? // original id from data/*.json (S9)
  museumId         String
  museum           Museum   @relation(fields: [museumId], references: [id], onDelete: Restrict)
  storyOrder       Int
  title            String
  roomOverviewText String   @db.Text // grounding prose for chat
  narrationScript  String   @db.Text // spoken script sent to TTS (S1)
  roomAudioUrl     String? // pre-generated narration audio
  nextRoomId       String?
  nextRoom         Room?    @relation("RoomSequence", fields: [nextRoomId], references: [id], onDelete: SetNull)
  previousRooms    Room[]   @relation("RoomSequence")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items       Item[]
  chatAnswers ChatAnswer[]

  @@unique([museumId, storyOrder]) // (S4)
  @@unique([museumId, legacyId])
  @@index([museumId])
  @@index([nextRoomId])
}

model Item {
  id               String   @id @default(uuid())
  legacyId         String?
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name             String
  shortDescription String
  detailText       String   @db.Text
  imageUrl         String?
  displayOrder     Int      @default(0) // (S5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chatAnswers ChatAnswer[]

  @@unique([roomId, legacyId])
  @@index([roomId, displayOrder])
}

// Deduplicates TTS output. Key is a hash of the exact synthesis inputs,
// so identical text in the same voice is only ever paid for once.
model AudioAsset {
  id          String   @id @default(uuid())
  contentHash String   @unique
  url         String
  voiceId     String
  model       String
  durationMs  Int?
  byteSize    Int?
  createdAt   DateTime @default(now())
}

// Serves two purposes: the answer cache, and the durable handle behind
// the audioUrl returned by POST /chat (C1).
model ChatAnswer {
  id           String   @id @default(uuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  itemId       String?
  item         Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  questionHash String   @unique // sha256(roomId : itemId : normalizedQuestion)
  question     String   @db.Text
  answer       String   @db.Text
  audioHash    String? // -> AudioAsset.contentHash once synthesized
  createdAt    DateTime @default(now())

  @@index([roomId])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String     @id @default(uuid())
  // Nullable because the payment reconciler acts with no human behind it
  // (dev3 §4). SetNull rather than Cascade so the trail outlives the account.
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  museumId    String?
  museum      Museum?   @relation(fields: [museumId], references: [id], onDelete: SetNull)
  action      String // CREATE | UPDATE | DELETE
  entityType  String // Museum | Room | Item | AdminUser
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([museumId, createdAt])
  @@index([adminUserId, createdAt])
}

// Prices live here rather than in code so a price change is a data edit, not a
// deploy. Tier *limits* live in code so changing them needs review and tests.
model TierPricing {
  tier        SubscriptionTier @id
  amountEtb   Decimal          @db.Decimal(10, 2)
  periodDays  Int              @default(30)
  displayName String
  description String?
  active      Boolean          @default(true)
  updatedAt   DateTime         @updatedAt
}

// One row per checkout attempt. Written before the provider is called, so a
// failed upstream call still leaves an auditable record. txRef is the unique
// idempotency key shared with the payment provider.
model Payment {
  id                 String           @id @default(uuid())
  museumId           String
  museum             Museum           @relation(fields: [museumId], references: [id], onDelete: Restrict)
  tier               SubscriptionTier
  amountEtb          Decimal          @db.Decimal(10, 2)
  currency           String           @default("ETB")
  txRef              String           @unique
  chapaReference     String?
  checkoutUrl        String?          @db.Text
  status             PaymentStatus    @default(PENDING)
  failureReason      String?
  periodStart        DateTime?
  periodEnd          DateTime?
  initiatedByAdminId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  paidAt             DateTime?

  @@index([museumId, createdAt])
  @@index([status, createdAt])
}
