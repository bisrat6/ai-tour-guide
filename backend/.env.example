# Copy to .env and fill in. See docs/backend-implementation-plan.md §5.
# The app refuses to boot if a required variable is missing or malformed.

# --- Core (required to boot) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tourguide:tourguide_dev_password@localhost:5432/ai_tour_guide
JWT_SECRET=                    # >= 32 chars; rotate invalidates all sessions
JWT_EXPIRES_IN=12h
CORS_ALLOWED_ORIGINS=           # comma-separated; admin web app origin(s)

# --- Tests only (§17.1) — a SEPARATE, throwaway database. Integration tests
# TRUNCATE every table between tests; never point this at DATABASE_URL. ---
TEST_DATABASE_URL=postgresql://tourguide:tourguide_dev_password@localhost:5432/ai_tour_guide_test

# --- Seed (D1-1/D1-2 only, never used at request time) ---
SEED_SYSTEM_ADMIN_EMAIL=system@adwa.dev
SEED_SYSTEM_ADMIN_PASSWORD=
SEED_MUSEUM_ADMIN_PASSWORD=     # shared dev password for the one MUSEUM_ADMIN seeded per museum

# --- LLM provider (§12.1) ---
# Leaving LLM_API_KEY empty makes the adapter answer from the prompt's own
# context offline, which is how development and the test suite stay off the
# network. Production refuses to boot without it (dev2 integration).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Any OpenAI-compatible /chat/completions endpoint: Gemini, Groq, OpenRouter, ...
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# Raise above 0 for models that spend tokens reasoning before answering, which
# would otherwise truncate the visible answer at max_tokens.
LLM_REASONING_TOKEN_HEADROOM=0
LLM_TIMEOUT_MS=15000

# --- TTS provider (§12.2) ---
# As with the LLM key: empty means placeholder audio locally, and production
# refuses to boot that way.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_TIMEOUT_MS=20000

# --- Object storage (§12.3) ---
# memory keeps development and tests free of a bucket; production refuses it
# because cached narration would not survive a restart. Selecting s3 requires
# STORAGE_BUCKET and STORAGE_PUBLIC_BASE_URL in every environment.
STORAGE_PROVIDER=memory
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
# true for S3-compatible vendors that address buckets by path (MinIO, some R2/B2).
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- Cost controls (§13) ---
CHAT_RATE_LIMIT_PER_5MIN=20
CHAT_MAX_QUESTION_CHARS=500
ANSWER_CACHE_TTL_HOURS=24

# --- Payments / Chapa (dev3 §4) - not required to boot ---
# WARNING: 'fake' grants tiers without taking money. Nothing currently refuses
# it in production — see docs/d3-integration-audit.md. Set to 'chapa' for any
# real deployment.
PAYMENTS_PROVIDER=fake
CHAPA_SECRET_KEY=               # required when PAYMENTS_PROVIDER=chapa
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_RETURN_URL=               # page the visitor returns to; required for checkout
CHAPA_TIMEOUT_MS=10000

# --- Ticketing (dev3 §6) - not required to boot ---
TICKETS_PROVIDER=fake
TICKET_VENDOR_TIMEOUT_MS=5000
ENABLE_STUB_TICKET_VENDOR=false # must stay false in production (enforced at boot)
STUB_TICKET_CODES=              # comma-separated codes the stub vendor accepts
# Lets the SSRF guard reach private addresses, e.g. a vendor stub on localhost.
OUTBOUND_HTTP_ALLOW_PRIVATE_IPS=false # must stay false in production (enforced at boot)
