# Core
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://adwa:adwa@db:5432/adwa
DATABASE_TEST_URL=postgresql://adwa:adwa@db-test:5432/adwa_test
JWT_SECRET=change-me-at-least-32-chars-long!!
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Chapa — paste your sandbox key
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_RETURN_URL=http://localhost:5173/billing
CHAPA_TIMEOUT_MS=10000
PAYMENTS_PROVIDER=chapa

# Ticketing
TICKETS_PROVIDER=http
TICKET_VENDOR_TIMEOUT_MS=5000
ENABLE_STUB_TICKET_VENDOR=true
STUB_TICKET_CODES=DEMO-1234,DEMO-5678,ADWA-VIP
OUTBOUND_HTTP_ALLOW_PRIVATE_IPS=true

# Seed
SEED_SYSTEM_ADMIN_EMAIL=system@adwa.local
SEED_SYSTEM_ADMIN_PASSWORD=Admin1234!
