# Copy to .env.local for local development. Vite only exposes VITE_-prefixed
# variables to the client, and they are baked in at build time — so changing
# this on Netlify requires a redeploy, not just a restart.
#
# Leave it unset to run the console in demo mode on fixtures.

# Local, against the backend's contract mock:
VITE_API_BASE_URL=http://localhost:4000

# Local, against the real server. Note 3001 — the committed backend .env uses
# that port, not the 3000 in its .env.example:
# VITE_API_BASE_URL=http://localhost:3001

# Deployed. Must be https, or the browser blocks it as mixed content:
# VITE_API_BASE_URL=https://your-service.onrender.com
